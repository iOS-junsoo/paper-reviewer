# Paper Reviewer 환경변수 — 이 파일을 .env로 복사해 채운다.
# 여기(.env.example)에는 실제 값을 절대 넣지 말 것. .gitignore 대상은 .env 뿐이다.

# ── 접속 비밀번호 (서버 배포 시 필수) ────────────────────────────────────────
# 비워두면 서버가 로컬(127.0.0.1) 요청만 받는다 — 외부 접속은 전부 503으로 막힌다.
# 공개 서버에서 이걸 비워두면 아무나 이 서버의 Claude 구독으로 분석을 돌릴 수 있다.
# 길고 무작위로 만들 것:  openssl rand -base64 24
APP_PASSWORD=

# ── LLM 인증 ────────────────────────────────────────────────────────────────
# 터미널에서 `claude setup-token` 실행 → 발급된 토큰 입력.
# macOS에서 실행할 때는 키체인 자격증명이 우선이라 이 값이 무시된다
# (설정 화면의 '계정 전환'이 그 키체인을 바꾸는 기능).
# Linux 서버에는 키체인이 없어 이 토큰이 유일한 인증 수단이다.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# (대안) API 크레딧 방식 — 현재 코드는 구독(Agent SDK) 경로만 쓰므로 사용하지 않음.
# 오히려 설정돼 있으면 서버가 시작 시 삭제한다(과금 경로 차단).
# ANTHROPIC_API_KEY=sk-ant-...

# 사용할 모델 (기본값: claude-opus-5)
MODEL=claude-opus-5

# ── 도메인 (Docker + Caddy 자동 HTTPS용) ────────────────────────────────────
# 이 서버를 가리키는 DNS A레코드가 먼저 있어야 인증서가 발급된다.
DOMAIN=

# ── 저장소(Firestore) ───────────────────────────────────────────────────────
# 둘 중 하나만 있으면 된다. 없으면 메모리 캐시로 폴백(재시작 시 결과 소실).
#  ① 키 파일 경로
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
#  ② 또는 키 JSON을 통째로 (서버에 파일을 옮기지 않아도 돼 배포에 편하다. ①보다 우선)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'

# ── 서버 ────────────────────────────────────────────────────────────────────
# 포트 (기본값: 3000)
PORT=3000

# 바인딩 주소. 기본 0.0.0.0. 프록시 없이 로컬 전용으로 쓰려면 127.0.0.1.
# HOST=0.0.0.0

# 상태 데이터(PDF 원본·크롭 캐시·ETA 통계) 위치. 기본은 코드와 같은 폴더.
# Docker 이미지는 /data로 이미 설정돼 있다.
# DATA_DIR=/data

# 리버스 프록시(Caddy·nginx) 뒤에 둘 때만 1. 프록시 없이 켜면 IP 위조가 가능하다.
# TRUST_PROXY=1

# 세션 서명키. 비워두면 DATA_DIR에 자동 생성해 재사용한다(재시작해도 로그인 유지).
# SESSION_SECRET=

# 시각화 자가검증용 Chrome 경로. Docker 이미지는 /usr/bin/chromium으로 설정돼 있다.
# CHROME_PATH=/usr/bin/chromium
